[Script]
http-request ^https?:\/\/([^\/]+\.)?(pangolin-sdk-toutiao\.com|pangle\.io|gdt\.qq\.com|e\.kuaishou\.com|sigmob\.cn|mintegral\.net|rayjump\.com|baidu\.com|bytesfield\.com|snssdk\.com|tnxrs\.com)\/ script-path=https://raw.githubusercontent.com/jackwude/qx/main/js/zk-ad-log.js?v=2, requires-body=false, tag=ZK助手抓包

[MITM]
hostname = *.pangolin-sdk-toutiao.com, *.pangle.io, *.gdt.qq.com, *.e.kuaishou.com, *.sigmob.cn, *.mintegral.net, *.rayjump.com, mobads.baidu.com, als.baidu.com, *.bytesfield.com, *.snssdk.com, *.tnxrs.com
